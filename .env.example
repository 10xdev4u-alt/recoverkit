# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                     # optional: Bearer guard for /api/cron/*
MONITORING_URL=                  # optional: cron pings this on success (healthcheck.ping etc.)

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=                # Connect OAuth client id (ca_...)
STRIPE_WEBHOOK_SECRET=           # platform webhook signing secret (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # publishable (anon, sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=              # service-role (sb_secret_...)
SUPABASE_DB_URL=                        # direct postgres URL for `supabase db push`

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=           # Svix signing secret for /api/resend/webhook

# Dunning defaults (override-able per account in Settings)
DUNNING_FROM_EMAIL=
DUNNING_REPLY_TO=
DUNNING_SUPPORT_EMAIL=
